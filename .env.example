# Copy this to .env and fill in your real credentials

# ── REQUIRED ──────────────────────────────────────────────────
ANTHROPIC_API_KEY=your_claude_api_key_here

# ── AFFILIATE NETWORKS (add the ones you join) ─────────────────
AMAZON_ASSOCIATE_TAG=yourtag-20
AMAZON_ACCESS_KEY=
AMAZON_SECRET_KEY=
CLICKBANK_API_KEY=
SHAREASALE_TOKEN=
SHAREASALE_SECRET=
SHAREASALE_MERCHANT_ID=

# ── EMAIL (Gmail App Password recommended) ─────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your@gmail.com
SMTP_PASSWORD=your_app_password
FROM_EMAIL=your@gmail.com
FROM_NAME=Your Newsletter Name

# ── SOCIAL MEDIA (optional, enables auto-posting) ─────────────
TWITTER_API_KEY=
TWITTER_API_SECRET=
TWITTER_ACCESS_TOKEN=
TWITTER_ACCESS_SECRET=
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USERNAME=
REDDIT_PASSWORD=

# ── SEO / SEARCH (SerpApi free tier = 100 searches/month) ─────
SERP_API_KEY=
GOOGLE_SEARCH_API_KEY=
GOOGLE_CSE_ID=

# ── APP ────────────────────────────────────────────────────────
BASE_URL=http://localhost:8000
SECRET_KEY=replace-with-random-secret
APP_PORT=8000

# ── NICHES TO TARGET (comma separated) ────────────────────────
TARGET_NICHES=health,fitness,personal finance,technology,home improvement
